{
  "artifact_version": "tensor_signal_data_requirements_v2",
  "step": 97,
  "title": "Tensor DB + signal CSV data availability audit",
  "status": "draft_contract",
  "claim_guardrails": {
    "trained_model": false,
    "performance_claim_allowed": false,
    "smoke_training_only": true,
    "smoke_evaluation_only": true,
    "matrix_smoke_evaluation_only": true,
    "causal_performance_claim_allowed": false,
    "daegu_citywide_performance_claim_allowed": false,
    "fleet_reduction_claim_allowed": false
  },
  "source_classes": {
    "tensor_db_direct": {
      "description": "Features already present in the tensor database or PyG dataset artifacts.",
      "allowed_for_causal_simulator_v2": true,
      "allowed_usage": [
        "static graph skeleton",
        "observed demand context",
        "time context",
        "edge distance/time/cost context",
        "baseline scenario indexing",
        "non-causal smoke validation metadata"
      ],
      "examples": [
        "node_uid",
        "node_index",
        "src_idx",
        "dst_idx",
        "distance_m",
        "time_sec",
        "generalized_cost",
        "long_edge_5km_flag",
        "boardings_recent_log",
        "alightings_recent_log",
        "waiting_passenger_cnt_log",
        "hour_sin",
        "hour_cos",
        "is_peak",
        "next_boardings_recent",
        "next_alightings_recent",
        "next_waiting_passenger_cnt",
        "state_ts",
        "next_state_ts",
        "time_band",
        "service_date",
        "window_id"
      ]
    },
    "signal_csv_direct": {
      "description": "Fields directly obtainable from the Daegu traffic signal CSV without simulation.",
      "allowed_for_causal_simulator_v2": true,
      "allowed_usage": [
        "static signal infrastructure feature",
        "node/edge neighborhood signal inventory",
        "spatial complexity proxy"
      ],
      "examples": [
        "signal_id",
        "signal_type",
        "signal_name",
        "latitude",
        "longitude",
        "x_coord",
        "y_coord",
        "pedestrian_signal_flag",
        "blink_signal_flag",
        "controlled_signal_flag",
        "installation_location"
      ],
      "notes": [
        "Column names may differ by CSV source. The inspector script infers likely columns from multiple candidate names.",
        "Direct signal CSV fields must not be interpreted as dynamic signal phases."
      ]
    },
    "tensor_db_plus_signal_csv_derived": {
      "description": "Features generated by joining tensor DB graph nodes/edges with static signal infrastructure locations.",
      "allowed_for_causal_simulator_v2": true,
      "allowed_usage": [
        "static node feature extension",
        "static edge feature extension",
        "causal simulator context feature",
        "policy observation context only"
      ],
      "examples": [
        "signal_count_within_100m",
        "signal_count_within_250m",
        "signal_count_within_500m",
        "signal_density_per_km",
        "nearest_signal_distance_m",
        "pedestrian_signal_count_within_250m",
        "blink_signal_ratio_within_250m",
        "controlled_signal_ratio_within_250m",
        "edge_signal_count",
        "edge_signal_density_per_km",
        "edge_nearest_signal_distance_m"
      ]
    },
    "proxy_only": {
      "description": "Quantities that may be represented only as coarse proxies, not as directly observed causal mechanisms.",
      "allowed_for_causal_simulator_v2": true,
      "allowed_usage": [
        "weak prior",
        "environment difficulty proxy",
        "route complexity proxy",
        "context feature with explicit proxy marker"
      ],
      "must_mark_columns_with": "_proxy",
      "examples": [
        "intersection_complexity_proxy",
        "signal_delay_risk_proxy",
        "stop_access_friction_proxy",
        "edge_control_complexity_proxy"
      ],
      "warnings": [
        "These features must not be reported as measured red-light delay or measured signal timing.",
        "Proxy features may help policy conditioning but cannot support standalone traffic-signal causal claims."
      ]
    },
    "currently_unavailable": {
      "description": "Data not available from current tensor DB and static signal CSV.",
      "allowed_for_causal_simulator_v2": false,
      "examples": [
        "red_light_delay_seconds",
        "green_time_seconds",
        "cycle_length_seconds",
        "phase_sequence",
        "signal_offset_seconds",
        "real_time_signal_state",
        "queue_discharge_rate",
        "lane_level_turning_movement",
        "actual_vehicle_trajectory",
        "actual_bus_arrival_second_level",
        "incident_event_stream",
        "weather_event_stream"
      ],
      "hard_rule": "Do not synthesize these as if observed. If used later, they require new data source, calibrated simulator, or explicit synthetic assumption document."
    }
  },
  "causal_simulator_v2_admission_rules": {
    "admit": [
      "tensor_db_direct",
      "signal_csv_direct",
      "tensor_db_plus_signal_csv_derived",
      "proxy_only_with_explicit_proxy_suffix"
    ],
    "reject": [
      "currently_unavailable",
      "dynamic_signal_phase_claims",
      "red_light_delay_claims_without_phase_data",
      "fleet_reduction_performance_claims_from_toy_or_smoke_runs"
    ]
  },
  "step_98_signal_feature_builder_contract_draft": {
    "script_name": "build_signal_features_for_causal_simulator_v2.py",
    "inputs": {
      "signal_csv": {
        "required": true,
        "format": "csv",
        "encoding_candidates": ["utf-8-sig", "utf-8", "cp949", "euc-kr"]
      },
      "tensor_node_table_or_file": {
        "required": true,
        "examples": [
          "public.gatv2_node_master_active",
          "node_master.parquet"
        ]
      },
      "tensor_edge_table_or_file": {
        "required": true,
        "examples": [
          "public.gatv2_edge_primary_active",
          "edge_primary.parquet"
        ]
      },
      "coordinate_reference": {
        "required": true,
        "allowed_values": [
          "EPSG:4326",
          "EPSG:5187",
          "unknown_requires_manual_mapping"
        ]
      }
    },
    "outputs": {
      "node_signal_features": {
        "format": "parquet",
        "required_columns": [
          "node_uid",
          "node_index",
          "signal_count_250m",
          "nearest_signal_distance_m",
          "pedestrian_signal_count_250m",
          "blink_signal_ratio_250m",
          "controlled_signal_ratio_250m",
          "signal_feature_quality_flag"
        ]
      },
      "edge_signal_features": {
        "format": "parquet",
        "required_columns": [
          "src_idx",
          "dst_idx",
          "edge_signal_count",
          "edge_signal_density_per_km",
          "edge_nearest_signal_distance_m",
          "edge_signal_feature_quality_flag"
        ]
      },
      "feature_contract_json": {
        "format": "json",
        "must_include": [
          "source_csv_path",
          "source_csv_hash",
          "coordinate_reference",
          "join_method",
          "feature_definitions",
          "unavailable_dynamic_signal_fields"
        ]
      }
    }
  }
}
