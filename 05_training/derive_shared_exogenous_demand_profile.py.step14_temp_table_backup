    contract.setdefault("input_artifacts", {})
    contract["input_artifacts"]["shared_exogenous_demand_profile"] = str(
        PROFILE_PATH.relative_to(PROJECT_ROOT)
    ).replace("\\", "/")

    contract["shared_exogenous_demand_policy"] = {
        "artifact_version": "shared_exogenous_demand_profile_v1",
        "profile_name": "empirical_2023_time_band_demand_profile",
        "status": "ADOPTED_EMPIRICAL",
        "arrival_multiplier_by_time_band": multipliers,
        "same_profile_for_conditions": [
            "B0R_current_ops_reconstructed",
            "B1_noop",
            "B2_rulebased",
            "A_pure_mappo",
        ],
        "condition_specific_demand_allowed": False,
        "post_hoc_tuning_allowed": False,
    }

    with CONTRACT_PATH.open("w", encoding="utf-8") as f:
        json.dump(contract, f, ensure_ascii=False, indent=2)

    print("")
    print("=== Empirical 2023 time-band demand profile ===")
    print(summary_df.to_string(index=False))
    print("")
    print(f"[OK] selected join variant: {best_name}")
    print(f"[OK] arrival_multiplier_by_time_band: {multipliers}")
    print(f"[OK] wrote YAML : {PROFILE_PATH}")
    print(f"[OK] wrote JSON : {REPORT_JSON_PATH}")
    print(f"[OK] wrote CSV  : {REPORT_CSV_PATH}")
    print("[OK] linked profile into current_ops_reconstructed_v1.yaml")
    print("[OK] linked profile into phase2_causal_contract.json")
    print("STEP 14 EMPIRICAL DEMAND PROFILE PASS")


