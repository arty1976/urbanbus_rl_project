"""
run_b1_noop_rollout.py — Phase 1 replay-backed B1 No-op Baseline Rollout Writer

[IMPORTANT] Phase 1 Non-Causal Replay Only
This script produces rollout artifacts via HistoricalReplayAdapter.
The adapter replays historical snapshots; agent actions DO NOT change the
next state.  Output artifacts are for:
  - contract / schema verification
  - canonical KPI pipeline wiring validation
  - replay-backed artifact generation
They are NOT valid for official B1 vs B2 vs A performance comparison.

Phase 2 (causal simulator-backed evaluation) is required for real comparisons.
"""
import argparse
import datetime
import hashlib
import json
import os
import sys
import traceback
from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd

# ---------------------------------------------------------------------------
# Inject 05_training directory into sys.path so that
# "adapters.historical_replay_adapter.HistoricalReplayAdapter" resolves.
# ---------------------------------------------------------------------------
_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
if _THIS_DIR not in sys.path:
    sys.path.insert(0, _THIS_DIR)

from simulator_adapter_interface import load_adapter_class  # noqa: E402


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _load_json(path: Path) -> Dict[str, Any]:
    for enc in ("utf-8-sig", "utf-8"):
        try:
            with open(path, "r", encoding=enc) as f:
                return json.load(f)
        except Exception:
            pass
    raise RuntimeError(f"failed to read json: {path}")


def _dump_json(path: Path, payload: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2, default=str)


def _stable_int(seed: int, window_id: str) -> int:
    s = f"{seed}|{window_id}"
    return int(hashlib.sha256(s.encode("utf-8")).hexdigest()[:8], 16)


def _classify_time_band(hour: int) -> str:
    if 7 <= hour <= 9 or 17 <= hour <= 19:
        return "peak"
    if 22 <= hour or hour < 5:
        return "night"
    return "offpeak"


# ---------------------------------------------------------------------------
# Rollup KPI generation from adapter step results
# ---------------------------------------------------------------------------
_NONCAUSAL_NOTE = (
    "Phase 1 non-causal historical replay. "
    "Actions do not affect next state. "
    "Not valid for official B1 vs B2 vs A performance comparison."
)

_PLACEHOLDER_NOTE = (
    "headway/bunching/ontime/wait/energy values are Phase 1 replay-backed "
    "placeholders, not real causal measurements."
)


def _base_by_time_band(time_band: str) -> Dict[str, float]:
    """Deterministic placeholder KPI base values per time band."""
    tb = str(time_band).strip().lower()
    if tb == "peak":
        return {
            "headway_mean": 540.0, "headway_std": 150.0,
            "headway_events": 6, "wait_avg": 360.0,
            "sched_arrivals": 6, "energy": 120.0,
        }
    if tb == "night":
        return {
            "headway_mean": 900.0, "headway_std": 90.0,
            "headway_events": 3, "wait_avg": 180.0,
            "sched_arrivals": 3, "energy": 70.0,
        }
    return {
        "headway_mean": 660.0, "headway_std": 110.0,
        "headway_events": 5, "wait_avg": 240.0,
        "sched_arrivals": 5, "energy": 90.0,
    }


def _build_window_rollup_row(
    *,
    seed: int,
    window_id: Any,
    state_ts: str,
    service_date: str,
    time_band: str,
    eval_horizon_minutes: int,
    mean_reward: float,
    effective_replay_step_minutes: float,
) -> Dict[str, Any]:
    """
    Build a single window_rollup row.

    KPI values are derived from deterministic placeholder logic seeded by
    (seed, window_id).  This replaces the stub generator so that the rollout
    script itself produces canonical-aggregator-compatible output.

    [IMPORTANT] These are Phase 1 replay-backed placeholders.
    """
    tb = str(time_band).strip().lower()
    base = _base_by_time_band(tb)
    h = _stable_int(seed, str(window_id))

    headway_events = int(base["headway_events"])
    headway_sample_count = headway_events + 1

    headway_mean_seconds = float(base["headway_mean"] + (h % 31) - 15 + seed * 3)
    headway_std_seconds = float(max(1.0, base["headway_std"] + (h % 21) - 10))

    wait_passenger_count = int(20 + (h % 41))
    avg_wait_seconds = float(base["wait_avg"] + (h % 31) - 15 + seed * 2)
    wait_total_passenger_seconds = float(avg_wait_seconds * wait_passenger_count)

    schedulable_arrival_count = int(base["sched_arrivals"])
    ontime_event_count = int(max(0, min(
        schedulable_arrival_count,
        round(schedulable_arrival_count * (0.70 + (h % 16) / 100.0))
    )))

    if tb == "peak":
        bunching_event_count = int(h % 3)
    elif tb == "offpeak":
        bunching_event_count = int(h % 2)
    else:
        bunching_event_count = 0
    bunching_event_count = min(bunching_event_count, headway_events)

    # B1 No-op: zero interventions
    intervention_count = 0
    decision_step_count = 1
    energy_proxy_total = float(base["energy"] + (h % 23))

    return {
        "condition_id": "B1",
        "seed": int(seed),
        "window_id": window_id,
        "state_ts": str(state_ts),
        "service_date": str(service_date),
        "time_band": tb,
        "evaluation_horizon_minutes": int(eval_horizon_minutes),
        "qwen_trigger_rate": 0.0,
        "effective_replay_step_minutes": float(effective_replay_step_minutes),
        "headway_mean_seconds": headway_mean_seconds,
        "headway_std_seconds": headway_std_seconds,
        "headway_sample_count": headway_sample_count,
        "bunching_event_count": bunching_event_count,
        "headway_event_count": headway_events,
        "wait_total_passenger_seconds": wait_total_passenger_seconds,
        "wait_passenger_count": wait_passenger_count,
        "ontime_event_count": ontime_event_count,
        "schedulable_arrival_count": schedulable_arrival_count,
        "intervention_count": intervention_count,
        "decision_step_count": decision_step_count,
        "energy_proxy_total": energy_proxy_total,
        "source_mode": "historical_replay_b1_phase1",
    }


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="B1 No-op Baseline rollout via HistoricalReplayAdapter (Phase 1)"
    )
    parser.add_argument("--scenario-index", required=True,
                        help="Path to scenario_index.parquet")
    parser.add_argument("--output-dir", required=True,
                        help="Seed-level output directory (e.g. .../rollouts/seed_001)")
    parser.add_argument("--seed", type=int, required=True)
    parser.add_argument("--eval-horizon-minutes", type=int, default=30)
    parser.add_argument("--simulator-adapter", default="",
                        help="Dotted import path to adapter class")
    parser.add_argument("--limit", type=int, default=0,
                        help="If > 0, process only the first N scenario windows")
    parser.add_argument("--write-raw-events", action="store_true", default=True,
                        help="Write raw_events.parquet (default: True)")
    return parser.parse_args()


def main() -> None:
    args = parse_args()

    scenario_index = Path(args.scenario_index)
    output_dir = Path(args.output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    status_path = output_dir / "status.json"
    manifest_path = output_dir / "run_manifest.json"

    # ------------------------------------------------------------------
    # 1. Write initial status
    # ------------------------------------------------------------------
    status: Dict[str, Any] = {
        "status": "starting",
        "seed": args.seed,
        "simulator_adapter_path": args.simulator_adapter,
        "causal_comparison_allowed": False,
        "note": _NONCAUSAL_NOTE,
    }
    _dump_json(status_path, status)

    # ------------------------------------------------------------------
    # 2. Validate scenario index
    # ------------------------------------------------------------------
    if not scenario_index.exists():
        status["status"] = "rollout_failed"
        status["reason"] = f"scenario_index not found: {scenario_index}"
        _dump_json(status_path, status)
        raise SystemExit(status["reason"])

    df = pd.read_parquet(scenario_index)
    required = ["window_id", "state_ts", "service_date", "time_band"]
    missing = [c for c in required if c not in df.columns]
    if missing:
        status["status"] = "rollout_failed"
        status["reason"] = f"Missing required columns: {missing}"
        _dump_json(status_path, status)
        raise SystemExit(status["reason"])

    df["time_band"] = df["time_band"].astype(str).str.strip().str.lower()

    if args.limit and args.limit > 0:
        df = df.head(args.limit).copy()

    if df.empty:
        status["status"] = "rollout_failed"
        status["reason"] = "scenario_index is empty after limit"
        _dump_json(status_path, status)
        raise SystemExit(status["reason"])

    # ------------------------------------------------------------------
    # 3. Load adapter
    # ------------------------------------------------------------------
    if not args.simulator_adapter:
        status["status"] = "adapter_missing"
        status["reason"] = "simulator adapter not configured"
        _dump_json(status_path, status)

        manifest = {
            "baseline_id": "B1_noop",
            "seed": args.seed,
            "eval_horizon_minutes": args.eval_horizon_minutes,
            "scenario_count": int(len(df)),
            "scenario_index": str(scenario_index),
            "output_dir": str(output_dir),
            "simulator_adapter": "",
            "status": "adapter_missing",
        }
        _dump_json(manifest_path, manifest)
        print("[STOP] No simulator adapter configured.")
        print("[STOP] B1 contract is prepared, but real rollouts cannot run yet.")
        print(f"[OK] wrote: {manifest_path}")
        return

    try:
        adapter_cls = load_adapter_class(args.simulator_adapter)
    except Exception as exc:
        status["status"] = "adapter_load_failed"
        status["reason"] = f"Failed to load adapter: {exc}"
        _dump_json(status_path, status)
        raise SystemExit(status["reason"])

    adapter_config = {"num_agents": 10}
    adapter = adapter_cls(config=adapter_config)
    adapter_class_name = type(adapter).__name__

    status["status"] = "rollout_running"
    status["adapter_class"] = adapter_class_name
    _dump_json(status_path, status)

    print(f"[OK] adapter loaded: {adapter_class_name}")
    print(f"[OK] scenario windows: {len(df)}")

    # ------------------------------------------------------------------
    # 4. Rollout loop
    # ------------------------------------------------------------------
    raw_event_rows: List[Dict[str, Any]] = []
    window_rollup_rows: List[Dict[str, Any]] = []

    for idx, row in df.iterrows():
        window_id = row["window_id"]
        state_ts = str(row["state_ts"])
        service_date = str(row["service_date"])
        time_band = str(row["time_band"]).strip().lower()

        # --- reset adapter for this window ---
        scenario_config = {
            "window_id": window_id,
            "state_ts": state_ts,
            "service_date": service_date,
            "time_band": time_band,
        }
        obs = adapter.reset(seed=args.seed, scenario_config=scenario_config)

        # --- no-op action: all agents take action=0 ---
        agent_ids = obs.get("agent_ids", list(range(adapter.num_agents)))
        noop_actions = {aid: 0 for aid in agent_ids}

        # --- step ---
        step_result = adapter.step(noop_actions)

        effective_replay_step_minutes = step_result.info.get(
            "effective_replay_step_minutes", 60.0
        )

        # --- record raw events (one row per agent per window) ---
        for aid in agent_ids:
            reward = step_result.rewards.get(aid, 0.0)
            raw_event_rows.append({
                "condition_id": "B1",
                "baseline_id": "B1_noop",
                "seed": args.seed,
                "window_id": window_id,
                "state_ts": state_ts,
                "service_date": service_date,
                "time_band": time_band,
                "agent_id": aid,
                "action": 0,
                "reward": float(reward),
                "intervention_applied": 0,
                "terminated": step_result.terminated,
                "truncated": step_result.truncated,
                "qwen_trigger_rate": 0.0,
                "effective_replay_step_minutes": float(effective_replay_step_minutes),
                "source_mode": "historical_replay_b1_phase1",
                "note": _NONCAUSAL_NOTE,
            })

        # --- build window_rollup row ---
        mean_reward = sum(step_result.rewards.values()) / max(1, len(step_result.rewards))
        rollup_row = _build_window_rollup_row(
            seed=args.seed,
            window_id=window_id,
            state_ts=state_ts,
            service_date=service_date,
            time_band=time_band,
            eval_horizon_minutes=args.eval_horizon_minutes,
            mean_reward=mean_reward,
            effective_replay_step_minutes=effective_replay_step_minutes,
        )
        window_rollup_rows.append(rollup_row)

    # ------------------------------------------------------------------
    # 5. Write outputs
    # ------------------------------------------------------------------
    raw_events_df = pd.DataFrame(raw_event_rows)
    window_rollup_df = pd.DataFrame(window_rollup_rows)

    raw_events_path = output_dir / "raw_events.parquet"
    window_rollup_path = output_dir / "window_rollup.parquet"

    if args.write_raw_events:
        raw_events_df.to_parquet(raw_events_path, index=False)
        print(f"[OK] raw_events      : {raw_events_path}  rows={len(raw_events_df)}")

    window_rollup_df.to_parquet(window_rollup_path, index=False)
    print(f"[OK] window_rollup   : {window_rollup_path}  rows={len(window_rollup_df)}")

    # ------------------------------------------------------------------
    # 6. Write manifest
    # ------------------------------------------------------------------
    manifest = {
        "baseline_id": "B1_noop",
        "seed": args.seed,
        "eval_horizon_minutes": args.eval_horizon_minutes,
        "scenario_count": int(len(df)),
        "scenario_count_processed": int(len(window_rollup_df)),
        "scenario_index": str(scenario_index),
        "output_dir": str(output_dir),
        "simulator_adapter": args.simulator_adapter,
        "adapter_class": adapter_class_name,
        "raw_events_path": str(raw_events_path) if args.write_raw_events else None,
        "raw_event_rows": int(len(raw_events_df)),
        "window_rollup_path": str(window_rollup_path),
        "window_rollup_rows": int(len(window_rollup_df)),
        "window_rollup_mode": "historical_replay_b1_phase1",
        "status": "rollout_completed_noncausal",
        "causal_comparison_allowed": False,
        "note": _NONCAUSAL_NOTE,
        "placeholder_note": _PLACEHOLDER_NOTE,
    }
    _dump_json(manifest_path, manifest)
    print(f"[OK] manifest        : {manifest_path}")

    # ------------------------------------------------------------------
    # 7. Write final status
    # ------------------------------------------------------------------
    status.update({
        "status": "rollout_completed_noncausal",
        "seed": args.seed,
        "scenario_count_processed": int(len(window_rollup_df)),
        "raw_event_rows": int(len(raw_events_df)),
        "window_rollup_rows": int(len(window_rollup_df)),
        "simulator_adapter_path": args.simulator_adapter,
        "adapter_class": adapter_class_name,
        "qwen_trigger_rate": 0.0,
        "causal_comparison_allowed": False,
        "note": _NONCAUSAL_NOTE,
        "placeholder_note": _PLACEHOLDER_NOTE,
    })
    _dump_json(status_path, status)
    print(f"[OK] status          : {status_path}")

    # --- close adapter ---
    adapter.close()
    print(f"[DONE] B1 No-op rollout complete (seed={args.seed}, windows={len(window_rollup_df)})")
    print(f"[WARN] {_NONCAUSAL_NOTE}")


if __name__ == "__main__":
    main()
